{
  "name": "cloud-ide-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:create": "npm run -s typeorm -- migration:create",
    "migration:run": "npm run -s typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run -s typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:show": "npm run -s typeorm -- migration:show -d src/database/data-source.ts",
    "migration:check": "npm run -s typeorm -- migration:generate --check -d src/database/data-source.ts src/database/migrations/Check"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
